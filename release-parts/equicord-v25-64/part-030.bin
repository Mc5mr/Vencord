44\u0631\u0627\u0628\u0637 \u0623\u062F\u0646\u0627\u0647 (\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0645\u0631\u0641\u0648\u0639 \u0644\u0647 \u0627\u0644\u0623\u0648\u0644\u0648\u064A\u0629 \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637).","OFF - a built-in tone generated in the app. ON - use the uploaded file or URL below (an uploaded file takes priority over the URL).")},customJoinSoundData:{type:0,default:"",description:"",hidden:!0},customJoinSoundDataName:{type:0,default:"",description:"",hidden:!0},customJoinSound:{type:0,default:"",description:y("\u0631\u0627\u0628\u0637 \u0627\u062D\u062A\u064A\u0627\u0637\u064A \u0644\u0644\u0627\u0646\u0636\u0645\u0627\u0645 (\u200Fhttps://...\u200F) \u2014 \u064A\u064F\u0633\u062A\u062E\u062F\u064E\u0645 \u0641\u0642\u0637 \u0625\u0646 \u0644\u0645 \u064A\u064F\u0631\u0641\u064E\u0639 \u0645\u0644\u0641 \u0623\u0639\u0644\u0627\u0647. \u0641\u0627\u0631\u063A = \u0627\u0644\u0646\u063A\u0645\u0629 \u0627\u0644\u0645\u062F\u0645\u062C\u0629.","JOIN fallback URL (https://...) \u2014 used only if no file is uploaded above. Empty = the built-in tone.")},customJoinUpload:{type:6,description:y("\u0627\u0631\u0641\u0639 \u0635\u0648\u062A \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 (\u064A\u0633\u062A\u0628\u062F\u0644 \u0627\u0644\u0631\u0641\u0639 \u0627\u0644\u0633\u0627\u0628\u0642).","Upload JOIN sound (replaces previous upload)."),component:()=>r(YMt,{label:y("\u0627\u0631\u0641\u0639 \u0635\u0648\u062A \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645","Upload JOIN Sound"),dataKey:"customJoinSoundData"})},customLeaveSoundData:{type:0,default:"",description:"",hidden:!0},customLeaveSoundDataName:{type:0,default:"",description:"",hidden:!0},customLeaveSound:{type:0,default:"",description:y("\u0631\u0627\u0628\u0637 \u0627\u062D\u062A\u064A\u0627\u0637\u064A \u0644\u0644\u0645\u063A\u0627\u062F\u0631\u0629 (\u200Fhttps://...\u200F) \u2014 \u064A\u064F\u0633\u062A\u062E\u062F\u064E\u0645 \u0641\u0642\u0637 \u0625\u0646 \u0644\u0645 \u064A\u064F\u0631\u0641\u064E\u0639 \u0645\u0644\u0641 \u0623\u0639\u0644\u0627\u0647. \u0641\u0627\u0631\u063A = \u0627\u0644\u0646\u063A\u0645\u0629 \u0627\u0644\u0645\u062F\u0645\u062C\u0629.","LEAVE fallback URL (https://...) \u2014 used only if no file is uploaded above. Empty = the built-in tone.")},customLeaveUpload:{type:6,description:y("\u0627\u0631\u0641\u0639 \u0635\u0648\u062A \u0627\u0644\u0645\u063A\u0627\u062F\u0631\u0629 (\u064A\u0633\u062A\u0628\u062F\u0644 \u0627\u0644\u0631\u0641\u0639 \u0627\u0644\u0633\u0627\u0628\u0642).","Upload LEAVE sound (replaces previous upload)."),component:()=>r(YMt,{label:y("\u0627\u0631\u0641\u0639 \u0635\u0648\u062A \u0627\u0644\u0645\u063A\u0627\u062F\u0631\u0629","Upload LEAVE Sound"),dataKey:"customLeaveSoundData"})},serverHeader:{type:6,description:"",component:()=>r(AP,{title:y("\u0645\u0631\u0634\u0651\u062D \u0627\u0644\u0633\u064A\u0631\u0641\u0631\u0627\u062A","Server Filter"),color:aP.server})},serverFilterMode:{type:4,options:[{label:y("\u0643\u0644 \u0627\u0644\u0633\u064A\u0631\u0641\u0631\u0627\u062A","All servers"),value:"none",default:!0},{label:y("\u062A\u0636\u0645\u064A\u0646 \u0627\u0644\u0633\u064A\u0631\u0641\u0631\u0627\u062A \u0627\u0644\u0645\u062F\u0631\u064E\u062C\u0629 \u0641\u0642\u0637","Include only listed servers"),value:"include"},{label:y("\u0627\u0633\u062A\u062B\u0646\u0627\u0621 \u0627\u0644\u0633\u064A\u0631\u0641\u0631\u0627\u062A \u0627\u0644\u0645\u062F\u0631\u064E\u062C\u0629","Exclude listed servers"),value:"exclude"}],description:y("\u0623\u064A\u0651 \u0627\u0644\u0633\u064A\u0631\u0641\u0631\u0627\u062A \u062A\u064F\u0634\u063A\u0651\u0644 \u062A\u0646\u0628\u064A\u0647\u0627\u062A StaffDetector.","Which servers trigger StaffDetector alerts.")},serverIncludeIds:{type:0,default:"",description:y("\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0633\u0645\u0627\u062D - \u0646\u0628\u0651\u0647 \u0641\u0642\u0637 \u0641\u064A \u0645\u0639\u0631\u0651\u0641\u0627\u062A \u0627\u0644\u0633\u064A\u0631\u0641\u0631\u0627\u062A \u0647\u0630\u0647. \u062A\u0642\u0628\u0644 \u0645\u0639\u0631\u0651\u0641\u0627\u064B \u0648\u0627\u062D\u062F\u0627\u064B \u0623\u0648 \u0623\u0643\u062B\u0631 \u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0627\u0635\u0644\u0629 \u0623\u0648 \u0645\u0633\u0627\u0641\u0629 \u0623\u0648 \u0634\u0631\u0637\u0629.","Allowlist - alert ONLY in these guild IDs. Accepts one or more IDs separated by comma, space, or dash.")},serverExcludeIds:{type:0,default:"",description:y("\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062D\u0638\u0631 - \u0644\u0627 \u062A\u0646\u0628\u0651\u0647 \u0623\u0628\u062F\u0627\u064B \u0641\u064A \u0645\u0639\u0631\u0651\u0641\u0627\u062A \u0627\u0644\u0633\u064A\u0631\u0641\u0631\u0627\u062A \u0647\u0630\u0647. \u062A\u0642\u0628\u0644 \u0645\u0639\u0631\u0651\u0641\u0627\u064B \u0648\u0627\u062D\u062F\u0627\u064B \u0623\u0648 \u0623\u0643\u062B\u0631 \u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0627\u0635\u0644\u0629 \u0623\u0648 \u0645\u0633\u0627\u0641\u0629 \u0623\u0648 \u0634\u0631\u0637\u0629. \u062A\u062A\u062C\u0627\u0648\u0632\u0647\u0627 \u0642\u0627\u0626\u0645\u0629 \u062A\u0636\u0645\u064A\u0646 \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645\u064A\u0646.","Blocklist - never alert in these guild IDs. Accepts one or more IDs separated by comma, space, or dash. Overridden by User Include list.")},userHeader:{type:6,description:"",component:()=>r(AP,{title:y("\u0645\u0631\u0634\u0651\u062D \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645\u064A\u0646","User Filter"),color:aP.user})},userIncludeIds:{type:0,default:"",description:y("\u062A\u062A\u0628\u0651\u0639 \u0645\u0639\u0631\u0651\u0641\u0627\u062A \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645\u064A\u0646 \u0647\u0630\u0647 \u0641\u0642\u0637 (\u0641\u0627\u0631\u063A = \u0643\u0644 \u0645\u0646 \u0644\u0647 \u0635\u0644\u0627\u062D\u064A\u0627\u062A \u0645\u0637\u0627\u0628\u0642\u0629). \u064A\u062A\u062C\u0627\u0648\u0632 \u0645\u0631\u0634\u0651\u062D \u0627\u0644\u0633\u064A\u0631\u0641\u0631 \u0648\u0641\u062D\u0635 \u0627\u0644\u0635\u0644\u0627\u062D\u064A\u0627\u062A \u2014 \u064A\u064F\u0639\u0644\u064E\u0651\u0645 \u062D\u062A\u0649 \u0628\u0644\u0627 \u0635\u0644\u0627\u062D\u064A\u0627\u062A \u0637\u0627\u0642\u0645. \u0645\u0641\u064A\u062F \u0644\u062A\u062A\u0628\u0651\u0639 \u062D\u0633\u0627\u0628\u0627\u062A \u0627\u0644\u0637\u0627\u0642\u0645 \u0627\u0644\u0645\u062A\u062E\u0641\u0651\u064A\u0629. \u064A\u0642\u0628\u0644 \u0645\u0639\u0631\u0651\u0641\u0627\u064B \u0648\u0627\u062D\u062F\u0627\u064B \u0623\u0648 \u0623\u0643\u062B\u0631 \u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0627\u0635\u0644\u0629 \u0623\u0648 \u0645\u0633\u0627\u0641\u0629 \u0623\u0648 \u0634\u0631\u0637\u0629.","Track ONLY these user IDs (empty = all with matching perms). Overrides server filter and permission check \u2014 flagged even without staff permissions. Useful to track undercover staff alts. Accepts one or more IDs separated by comma, space, or dash.")},userExcludeIds:{type:0,default:"",description:y("\u062A\u062C\u0627\u0647\u0644 \u0645\u0639\u0631\u0651\u0641\u0627\u062A \u0627\u0644\u0645\u0633\u062A\u062E\u062F\u0645\u064A\u0646 \u0647\u0630\u0647 \u0628\u063A\u0636\u0651 \u0627\u0644\u0646\u0638\u0631 \u0639\u0646 \u0627\u0644\u0635\u0644\u0627\u062D\u064A\u0627\u062A. \u062A\u0642\u0628\u0644 \u0645\u0639\u0631\u0651\u0641\u0627\u064B \u0648\u0627\u062D\u062F\u0627\u064B \u0623\u0648 \u0623\u0643\u062B\u0631 \u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0627\u0635\u0644\u0629 \u0623\u0648 \u0645\u0633\u0627\u0641\u0629 \u0623\u0648 \u0634\u0631\u0637\u0629.","Ignore these user IDs regardless of permissions. Accepts one or more IDs separated by comma, space, or dash.")},permsHeader:{type:6,description:"",component:()=>r(AP,{title:y("\u0627\u0644\u0635\u0644\u0627\u062D\u064A\u0627\u062A \u0627\u0644\u0645\u0643\u062A\u0634\u064E\u0641\u0629","Detected Permissions"),color:aP.perms})},adminPermission:{type:3,default:!0,description:"Administrator"},manageGuildPermission:{type:3,default:!0,description:"Manage Server"},manageChannelsPermission:{type:3,default:!0,description:"Manage Channels"},manageRolesPermission:{type:3,default:!0,description:"Manage Roles"},manageNicknamesPermission:{type:3,default:!1,description:"Manage Nicknames"},manageMessagesPermission:{type:3,default:!0,description:"Manage Messages"},kickMembersPermission:{type:3,default:!0,description:"Kick Members"},banMembersPermission:{type:3,default:!0,description:"Ban Members"},moderateMembersPermission:{type:3,default:!0,description:"Timeout / Moderate Members"},moveMembersPermission:{type:3,default:!0,description:"Move Members"},muteMembersPermission:{type:3,default:!0,description:"Mute Members"},deafenMembersPermission:{type:3,default:!0,description:"Deafen Members"}}),AV=[["adminPermission","ADMINISTRATOR"],["manageGuildPermission","MANAGE_GUILD"],["manageChannelsPermission","MANAGE_CHANNELS"],["manageRolesPermission","MANAGE_ROLES"],["manageNicknamesPermission","MANAGE_NICKNAMES"],["manageMessagesPermission","MANAGE_MESSAGES"],["kickMembersPermission","KICK_MEMBERS"],["banMembersPermission","BAN_MEMBERS"],["moderateMembersPermission","MODERATE_MEMBERS"],["moveMembersPermission","MOVE_MEMBERS"],["muteMembersPermission","MUTE_MEMBERS"],["deafenMembersPermission","DEAFEN_MEMBERS"]];dV=x({name:"StaffDetector",description:"Alerts (toast/notification + sound) when staff join or leave your VC.",tags:["Servers","Utility"],authors:[{name:"Mc5mr",id:523157034141745153n}],settings:mi,start(){let e=QMt.getVoiceChannelId?.()??null;aV=e,e&&TMt(e,!0)},flux:{VOICE_CHANNEL_SELECT({channelId:e}){e===aV||(aV=e,mI.clear(),!e)||!U.getChannel(e)?.guild_id||(mi.store.enableLogs&&(di.debug(`StaffDetector: joined VC ${e}`),Q0n(e)),TMt(e,!0))},VOICE_STATE_UPDATES({voiceStates:e}){let t=QMt.getVoiceChannelId?.()??null;if(!t)return;let n=U.getChannel(t);if(!