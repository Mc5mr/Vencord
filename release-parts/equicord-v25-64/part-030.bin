 title + Orbs reward title text color. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] [class*="header_"] {
    color: var(--questify-reward-title) !important;
}

/* Quest description text color. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] > div[class*="text-sm"] {
    color: var(--questify-reward-description) !important;
}

.questify-quest-item-restyle [class*="placeholderElement"] {
    background-color: transparent;
}

/* Promoted by XYZ text color. */
.questify-quest-item-restyle > div[class*="container"] > div[class*="positionContentOverBackground"] > div[class*="contents"] > div[class*="bottomRow"] > div[class*="text-sm"] {
    color: var(--questify-reward-description) !important;
}

.questify-quest-item-contrast-logo > div[class*="container"] > div[class*="positionContentOverBackground"] > div[class*="contents"] > div[class*="partnerBranding"] > img {
    filter: drop-shadow(0 0 10px rgb(0 0 0 / 80%));
}

.questify-quest-item-intense-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            var(--questify-color) 0,
            hsl(from var(--questify-color) h s l / 100%) 20.5%,
            hsl(from var(--questify-color) h s l / 99.5%) 23.33%,
            hsl(from var(--questify-color) h s l / 98%) 26.66%,
            hsl(from var(--questify-color) h s l / 97%) 30%,
            hsl(from var(--questify-color) h s l / 90%) 40%,
            hsl(from var(--questify-color) h s l / 77%) 50%,
            hsl(from var(--questify-color) h s l / 0%) 100%);
}

.questify-quest-item-default-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            var(--questify-color) 0,
            hsl(from var(--questify-color) h s l / 95%) 20.31%,
            hsl(from var(--questify-color) h s l / 0%) 100%);
}

.questify-quest-item-black-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            hsl(0deg 0% 0% / 80%) 10%,
            hsl(0deg 0% 0% / 65%) 20%,
            hsl(0deg 0% 0% / 50%) 50%,
            hsl(0deg 0% 0% / 10%) 75%,
            hsl(0deg 0% 0% / 0%) 90%);
}

.questify-quest-item-hide-gradient > :nth-child(1) [class*="overlay"] {
    display: none;
}

.questify-quest-item-restyle > :nth-child(2) [class*="textOverflowBlur"] {
    background: linear-gradient(transparent 50%, var(--questify-color) 100%);
    filter: brightness(0.9);
}

.questify-quest-item-restyle > :nth-child(2) > div button {
    background-color: var(--questify-button-normal) !important;
}

.questify-quest-item-restyle > :nth-child(2) > div button:not([disabled]):hover {
    background-color: var(--questify-button-hover) !important;
    transition: background-color 0.2s ease-in-out;
}

.questify-quest-item-restyle > :nth-child(1) [class*="container"] {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.questify-quest-item-restyle > :nth-child(2) [class*="container"] {
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

div[id^="quest-tile-"] div[class^="confetti__"] {
    pointer-events: none;
}

/* Quest Button */

#questify-dummy-quest-button {
    margin-right: -12px;
    margin-left: 5px;
    border-left: 5px solid var(--text-strong);
    border-radius: 4px;
}

.questify-quest-button-pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    pointer-events: none;
}

.questify-quest-button-pill > [class*="item"] {
    will-change: transform;
    max-height: 8px;
    min-height: 8px;
    transition: max-height 0.2s ease-in-out;
}

.questify-quest-button-pill.hovered > [class*="item"] {
    max-height: 20px;
}

.questify-quest-button-pill.selected > [class*="item"] {
    max-height: 40px;
}

.questify-quest-button-server-list-button-container {
    position: relative;
}

.questify-quest-button-icon-container {
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.questify-quest-button-container {
    position: relative;
}`,classNames:{},dom:null});vrt="src/equicordplugins/questify/styles.css"});function w0e(e){je().isOnQuestsPage=e??window.location.pathname===Mf}function Srt(e){let t=Date.now();w0e(),ed(),Grt(),mge(),mn.info(`START_TASKS-${e.toUpperCase()}`,{startedAt:t})}function Qrt(e,t=!0){let n=Date.now();w0e(),EJ(),C0e.clear(),TJ({manual:!1,preserveResume:t,terminalHeartbeat:!0}),mn.info(`STOP_TASKS-${e.toUpperCase()}`,{stoppedAt:n})}function Grt(){x0e||!s8||(x0e=!0,nUe())}function fVt(e){let t=wge({quest:e.quest});return t?r(q,{noop:!0},r(pVt,{size:e.size,variant:"secondary",disabled:!1,fullWidth:!0,...t})):null}function hVt(e){return r("span",{style:{fontSize:"90%"}},e)}var I0e,x0e,C0e,hb,pVt,lj,rj=h(()=>{"use strict";u();UA();xu();_();Hx();Z();L();me();v();n0e();_ot();wA();h4();Vg();qot();F0();XZ();brt();_Z();krt();Fy();p4();zy();m4();uC();kJ();Fl();I0e=!1,x0e=!1,C0e=new Set,hb=Vi.plugins.Questify?.enabled;pVt=ye("BUTTON_LOADING_STARTED_LABEL)),");lj=x({name:"Questify",description:"Enhance specific Quest features, disable annoyances, or completely remove Quests.",tags:["Appearance","Customisation","Privacy","Utility"],authors:[j.Etorix],dependencies:["AudioPlayerAPI","ServerListAPI"],startAt:"Init",managedStyle:vrt,settings:B0e,canOpenDevToolsWindow:CJ,canAutoCompleteQuest:Hy,disguiseHomeButton:Jot,enrolledIncompleteButton:fVt,formatLowerBadge:IJ,getActiveAutoCompletes:z0,getLastFilterChoices:Q7e,getLastSortChoice:k7e,getQuestAutoCompleteProgress:Z7e,getQuestEmbedProgress:a7e,getQuestButtonProps:wge,getQuestPanelOverride:r7e,getQuestPanelPercentComplete:Age,getQuestPanelSubtitleText:_7e,getQuestTileClasses:bJ,getQuestTileStyle:vJ,getSettingsModalOpen:Yot,hasEnabledAutoCompleteQuestTypes:x4,normalizeQuestName:km,openDevToolsWindow:pge,processQuestForAutoComplete:Ky,rerenderQuests:Pr,setHeartbeatStackTracePatchSucceeded:O7e,setLastFilterChoices:G7e,setLastSortChoice:S7e,setVideoProgressStackTracePatchSucceeded:J7e,shouldForceQuestPanelVisible:s7e,shouldPreloadQuestAssets:v7e,