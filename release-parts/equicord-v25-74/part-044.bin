 * \u0648\u0627\u0644\u0645\u0633\u062A\u0639\u0645\u0644 \u0641\u0639\u0644\u0627\u064B \u0647\u0648 \`messageContent_c19a55\`.
 *
 * \u0641\u0643\u0627\u0646\u062A \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u062A\u064F\u062D\u0642\u0646 \u0648\u0631\u0642\u0629\u064B \xAB\u0646\u0627\u062C\u062D\u0629\xBB \u0628\u0635\u0646\u0641\u064D \u0644\u0627 \u0648\u062C\u0648\u062F \u0644\u0647\u060C \u0648\u064A\u0642\u0648\u0644 \u0627\u0644\u0645\u0650\u062D\u0643\u0651 \u0625\u0646\u0651
 * \u0627\u0644\u0646\u0627\u0626\u0628 \u0627\u0645\u062A\u0644\u0623 \u0641\u064A\u064F\u0638\u0646\u0651 \u0623\u0646\u0651\u0647\u0627 \u062A\u0639\u0645\u0644. \u0627\u0645\u062A\u0644\u0627\u0621\u064F \u0627\u0644\u0646\u0627\u0626\u0628 \u0644\u064A\u0633 \u062F\u0644\u064A\u0644\u0627\u064B \u0639\u0644\u0649 \u0627\u0644\u0625\u0635\u0627\u0628\u0629.
 *
 * \u21D2 \`[class*="messageContent_"]\` \u064A\u0635\u064A\u0628 \u0623\u064A\u0651 \u0646\u0633\u062E\u0629\u064D \u0645\u0646 \u0627\u0644\u0635\u0646\u0641 \u0645\u0647\u0645\u0627 \u062A\u0628\u062F\u0651\u0644\u062A \u0628\u0635\u0645\u062A\u0647\u0627\u060C
 * \u0648\u0644\u0627 \u064A\u062D\u062A\u0627\u062C \u0628\u062D\u062B\u0627\u064B \u0641\u064A \u0627\u0644\u0648\u062D\u062F\u0627\u062A \u0641\u0644\u0627 \u064A\u0645\u0648\u062A \u0635\u0627\u0645\u062A\u0627\u064B. \u0648\u0642\u0650\u064A\u0633: \u0639\u0634\u0631\u0629 \u0639\u0646\u0627\u0635\u0631 \u0628\u0627\u0644\u0636\u0628\u0637 \u0645\u0646
 * \u0623\u0635\u0644 \u0665\u0668\u0668\u0660 \u0641\u064A \u0627\u0644\u0635\u0641\u062D\u0629 \u2014 \u062F\u0642\u064A\u0642\u064C \u0644\u0627 \u064A\u0644\u062A\u0647\u0645 \u063A\u064A\u0631\u0647.
 *
 * \u0648\`.mention\` \u0648\`a\` \u0648\`code\` \u0648\u0633\u0648\u0645\u064C \u0648\u0623\u0635\u0646\u0627\u0641\u064C \u062B\u0627\u0628\u062A\u0629 \u0644\u0627 \u062A\u064F\u0628\u0635\u064E\u0645.
 */

/* unicode-bidi: plaintext makes each line's base direction follow its own
   content (first strong character), overriding Discord's binary markupRtl
   guess. So an Arabic message that Discord mis-detected as LTR (because it
   starts with a number, a mention or a Latin word) is ordered correctly. */
[class*="messageContent_"] {
    unicode-bidi: plaintext;
}

/* Isolate inline LTR tokens so a mention, link, number-run or code span can't
   hijack the direction of the Arabic around it, nor reorder at its boundaries.
   isolate presents each as a single neutral object to the surrounding bidi.
   Replaced elements (emoji <img>) are already neutral, so they need nothing. */
[class*="messageContent_"] .mention,
[class*="messageContent_"] a,
[class*="messageContent_"] code {
    unicode-bidi: isolate;
}
`,classNames:{},dom:null});Kke="src/esharqplugins/smartBidi/style.css"});var NV,wDt=h(()=>{"use strict";u();io();L();CDt();NV=E({name:"SmartBidi",description:"Fix how Arabic and other right-to-left text renders when it's mixed with numbers, links, mentions or code \u2014 no more scrambled word order or misplaced punctuation.",authors:[{name:"Mc5mr",id:523157034141745153n}],tags:["Accessibility","Appearance"],start:()=>kn(Kke),stop:()=>Qn(Kke)})});var bP,EDt=h(()=>{u();(window.VencordStyles??=new Map).set("src/esharqplugins/smoothmessages/fade.css",{name:"src/esharqplugins/smoothmessages/fade.css",source:`/*
 * Vencord, a Discord client mod
 * Copyright (c) 2026 Vendicated and contributors
 * SPDX-License-Identifier: GPL-3.0-or-later
 */

@keyframes vc-smoothmessages-fade-in {
    from {
        opacity: 0;
        transform: translateX(-10px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

/* Only the newest row animates. Applying this to every list item meant that jumping to
   present, switching channel, or any scroll that remounted virtualised rows animated
   hundreds of items at once \u2014 which is what made jump-to-present stutter and flash. */
[--messageListItem]:not(:has(~ [--messageListItem])) {
    animation: vc-smoothmessages-fade-in 140ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@media (prefers-reduced-motion: reduce) {
    [--messageListItem]:not(:has(~ [--messageListItem])) {
        animation: none;
    }
}
