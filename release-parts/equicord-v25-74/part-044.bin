 */

@keyframes vc-smoothmessages-slide-in {
    from {
        transform: translateX(-10px);
    }

    to {
        transform: translateX(0);
    }
}

/* Only the newest row animates \u2014 see fade.css for why animating every row stutters. */
[--messageListItem]:not(:has(~ [--messageListItem])) {
    animation: vc-smoothmessages-slide-in 140ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@media (prefers-reduced-motion: reduce) {
    [--messageListItem]:not(:has(~ [--messageListItem])) {
        animation: none;
    }
}
