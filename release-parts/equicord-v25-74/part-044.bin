 * \u0627\u0644\u0635\u0641\u0648\u0641 \u0627\u0644\u0645\u062D\u062A\u0648\u0627\u0629 \u0628\u0639\u062F \u062A\u062D\u062F\u064A\u062B\u0627\u062A\u0647\u060C \u0641\u064A\u0633\u0628\u0651\u0628 \u0642\u0641\u0632 \u0627\u0644\u062A\u0645\u0631\u064A\u0631 \u0639\u0646\u062F \u0627\u0644\u0645\u0631\u0648\u0631 \u0639\u0644\u0649 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0648\u0642\u0635\u0651 \u0634\u0631\u064A\u0637
 * \u0627\u0644\u0623\u062F\u0648\u0627\u062A. \u0646\u064F\u0628\u0642\u064A \u0641\u0642\u0637 \u0631\u0641\u0639 \u0627\u0644\u0637\u0628\u0642\u0629 (z-index) \u0643\u064A \u0644\u0627 \u064A\u064F\u0642\u0635\u0651 \u0634\u0631\u064A\u0637 \u0627\u0644\u0623\u062F\u0648\u0627\u062A \u062A\u062D\u062A \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0627\u0644\u0623\u0639\u0644\u0649. */

[--messageListItem]:hover,
[--messageListItem]:focus-within {
    position: relative;
    z-index: 2;
}

[--messageListItem]:hover + [--messageListItem],
[--messageListItem]:focus-within + [--messageListItem],
[--messageListItem]:has(+ [--messageListItem]:hover),
[--messageListItem]:has(+ [--messageListItem]:focus-within) {
    z-index: 1;
}
