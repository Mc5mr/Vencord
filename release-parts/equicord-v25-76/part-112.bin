.vc-nc-account-label strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.vc-nc-account-check { color: var(--status-positive); font-weight: 700; }
.vc-nc-fake-managed-list, .vc-nc-local-account-rows { display: flex; flex-direction: column; gap: 6px; }
.vc-nc-fake-managed-row { display: flex; align-items: center; gap: 8px; padding: 6px; background: var(--background-secondary); border-radius: 8px; }
.vc-nc-fake-managed-row .vc-nc-account-label { flex: 1; }
.vc-nc-fake-switch, .vc-nc-account-more { padding: 6px 10px; color: var(--text-normal); background: var(--background-tertiary); border: 0; border-radius: 5px; cursor: pointer; }
.vc-nc-fake-switch:hover, .vc-nc-account-more:hover { background: var(--background-modifier-hover); }
.vc-nc-local-account-row { display: flex; width: 100%; padding: 8px; color: var(--text-normal); text-align: left; background: transparent; border: 0; border-radius: 6px; cursor: pointer; }
.vc-nc-local-account-row:hover, .vc-nc-local-account-row[aria-pressed="true"] { background: var(--background-modifier-selected); }
