.vc-nc-export-conversations { display: flex; flex-direction: column; gap: 4px; max-height: 240px; overflow: auto; }
.vc-nc-export-conversation { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px; color: var(--text-normal); text-align: left; background: var(--background-secondary); border: 1px solid transparent; border-radius: 6px; cursor: pointer; }
.vc-nc-export-conversation:hover { background: var(--background-modifier-hover); }
.vc-nc-export-conversation.selected { border-color: var(--brand-500); }
.vc-nc-export-options, .vc-nc-export-formats { display: flex; flex-wrap: wrap; gap: 8px; }
.vc-nc-export-options label { display: flex; align-items: center; gap: 5px; }
.vc-nc-export-formats button { display: flex; flex: 1 1 100px; flex-direction: column; gap: 4px; padding: 8px; color: var(--text-normal); background: var(--background-secondary); border: 1px solid var(--background-modifier-accent); border-radius: 6px; cursor: pointer; }
