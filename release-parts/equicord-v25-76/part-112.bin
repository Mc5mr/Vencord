{name:"src/userplugins/MicSettings.discordDesktop/styles.css",source:`[data-mana-component="modal"]:has(.vc-nc-mic) { width: 850px; max-width: calc(100vw - 32px); max-height: calc(100dvh - 40px); }
.vc-nc-mic { container-type: inline-size; display: grid; gap: 16px; padding-bottom: 8px; color: var(--text-normal); font-size: 14px; line-height: 1.4; }
.vc-nc-mic-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
.vc-nc-mic-middle { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 16px; }
.vc-nc-mic-middle.vc-nc-mic-simple { grid-template-columns: minmax(0, 4fr) minmax(100px, 1fr); }
.vc-nc-mic-card { padding: 16px; border: 1px solid var(--border-subtle, rgb(127 127 127 / 14%)); border-radius: 10px; display: flex; flex-direction: column; gap: 12px; min-width: 0; background: var(--background-surface-high, var(--background-secondary)); }
.vc-nc-mic-grid .vc-nc-mic-card { min-height: 132px; }
.vc-nc-mic-card strong { font-size: 16px; line-height: 1.3; font-weight: 600; }
.vc-nc-mic-card p { margin: 0; font-size: 14px; line-height: 1.4; }
.vc-nc-mic-value { display: flex; align-items: center; gap: 16px; min-width: 0; flex: 1; }
.vc-nc-mic-value > :first-child { flex: 1; min-width: 0; }
.vc-nc-mic-value > :not(.vc-nc-mic-status) input { width: 100%; }
.vc-nc-mic input { min-width: 0; min-height: 40px; padding: 8px 12px; border: 1px solid var(--border-subtle, rgb(127 127 127 / 15%)); border-radius: 8px; background: var(--input-background, var(--background-base-lowest)); color: var(--text-normal); font: inherit; font-size: 16px; }
.vc-nc-mic input:focus-visible { outline: 2px solid var(--brand-500); outline-offset: 1px; }
.vc-nc-mic-status { display: grid; gap: 6px; flex: 0 0 auto; white-space: nowrap; justify-items: center; }
.vc-nc-mic-status > span { font-size: 16px; font-weight: 600; }
.vc-nc-mic-unit { font-size: 14px; font-weight: 600; }
.vc-nc-mic-presets { display: flex; align-items: center; gap: 10px; min-height: 40px; margin-block: auto; }
.vc-nc-mic-presets > :first-child { flex: 1; min-width: 0; }
.vc-nc-mic .vc-nc-mic-icon-button { width: 32px; min-width: 32px; height: 32px; min-height: 32px; flex: 0 0 32px; padding: 0; border-radius: 7px; }
.vc-nc-mic-info { gap: 8px; }
.vc-nc-mic-feedback { display: grid; gap: 6px; margin-top: -6px; font-size: 12px; color: var(--text-muted); }
.vc-nc-mic-feedback p { margin: 0; }
.vc-nc-mic-feedback summary { cursor: pointer; }
.vc-nc-mic-feedback pre { margin: 6px 0 0; padding: 10px; border-radius: 8px; background: var(--background-base-lowest); color: var(--text-normal); font-size: 12px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
.vc-nc-mic-footer { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 12px; }
.vc-nc-mic-footer > span:first-child { flex: 1; min-width: 140px; font-size: 14px; color: var(--text-muted); }
.vc-nc-mic-footer a { color: var(--text-link); text-decoration: none; }
.vc-nc-mic-footer a:hover { text-decoration: underline; }
.vc-nc-mic-footer .vc-btn-base { min-height: 32px; padding: 6px 16px; font-size: 14px; border-radius: 7px; }
@container (width < 700px) { .vc-nc-mic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .vc-nc-mic-middle { grid-template-columns: 1fr; } }
@container (width < 360px) { .vc-nc-mic-grid { grid-template-columns: 1fr; } .vc-nc-mic-presets { gap: 6px; } }


