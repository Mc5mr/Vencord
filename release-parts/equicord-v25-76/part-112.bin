.vc-mc5mr-preview-heading, .vc-mc5mr-preview-hint-row, .vc-mc5mr-preview-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.vc-mc5mr-preview-profiles { display: flex; flex-wrap: wrap; gap: 8px; }
.vc-mc5mr-preview-profile { display: flex; align-items: center; gap: 6px; padding: 6px; border: 1px solid var(--background-modifier-accent); border-radius: 8px; }
.vc-mc5mr-preview-profile.selected { border-color: var(--brand-500); }
.vc-mc5mr-preview-toggles, .vc-mc5mr-preview-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.vc-mc5mr-preview-stats { display: flex; justify-content: space-between; padding: 10px; border-radius: 8px; background: var(--background-secondary); }
.vc-mc5mr-preview-stats span { display: flex; flex-direction: column; gap: 4px; }
.vc-mc5mr-preview-images { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 10px; min-height: 120px; max-height: 320px; overflow: auto; padding: 10px; border: 1px dashed var(--background-modifier-accent); border-radius: 8px; }
.vc-mc5mr-preview-images.empty { display: grid; place-items: center; text-align: center; }
.vc-mc5mr-preview-picture { display: flex; flex-direction: column; gap: 6px; }
.vc-mc5mr-preview-picture img { width: 100%; height: 100px; object-fit: cover; border-radius: 6px; }
.vc-mc5mr-preview-camera { font-size: 28px; }
.vc-mc5mr-preview-hint { color: var(--text-muted); font-size: 12px; }
