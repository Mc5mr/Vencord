.vc-mc5mr-mass-dm-top, .vc-mc5mr-mass-dm-summary, .vc-mc5mr-mass-dm-actions { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.vc-mc5mr-mass-dm-exclude { flex: 1; }
.vc-mc5mr-mass-dm-message { width: 100%; min-height: 150px; padding: 10px; color: var(--text-normal); background: var(--background-secondary); border: 1px solid var(--background-modifier-accent); border-radius: 6px; resize: vertical; }
.vc-mc5mr-mass-dm-delay { display: flex; align-items: center; gap: 8px; }
.vc-mc5mr-mass-dm-delay input { width: 70px; }
.vc-mc5mr-mass-dm-actions { justify-content: flex-start; }
.vc-mc5mr-mass-dm-composer [role="progressbar"] { height: 8px; overflow: hidden; background: var(--background-modifier-accent); border-radius: 4px; }
.vc-mc5mr-mass-dm-composer [role="progressbar"] > div { height: 100%; background: var(--brand-500); transition: width 150ms ease; }
.vc-mc5mr-header-button { color: var(--interactive-normal); }
