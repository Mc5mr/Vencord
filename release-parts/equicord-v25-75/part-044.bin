 *
 * \u0643\u0627\u0646\u062A \u0627\u0644\u0646\u0648\u0627\u0626\u0628 \`[--sidebar]\` \u0648\`[--membersWrap]\` \u0648\`[--members]\` \u062A\u064F\u0645\u0644\u0623 \u0645\u0646
 * \`findCssClasses("sidebar", "membersWrap", "members")\`\u060C \u0648\u0630\u0644\u0643 \u0646\u062F\u0627\u0621\u064C \u064A\u0634\u062A\u0631\u0637 \u0623\u0646
 * \u062A\u062C\u062A\u0645\u0639 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u062B\u0644\u0627\u062B\u0629 \u0641\u064A **\u0648\u062D\u062F\u0629\u064D \u0648\u0627\u062D\u062F\u0629**. \u0648\u0642\u0650\u064A\u0633 \u062D\u064A\u0651\u0627\u064B \u0623\u0646\u0651\u0647\u0627 \u0645\u0648\u0632\u0651\u0639\u0629 \u0639\u0644\u0649
 * \u0648\u062D\u062F\u062A\u064A\u0646: \`sidebar__5e434\` \u0641\u064A \u0648\u0627\u062D\u062F\u0629\u060C \u0648\`members\` \u0641\u064A \u0623\u062E\u0631\u0649. \u0641\u0627\u0644\u0645\u064F\u0631\u0634\u0650\u0651\u062D \u0644\u0627
 * \u064A\u064F\u0631\u0636\u064A\u0647 \u0634\u064A\u0621\u060C \u0648\u064A\u064F\u0631\u062C\u0639 \u0627\u0644\u0646\u062F\u0627\u0621\u064F \u0644\u0627 \u0634\u064A\u0621\u060C \u0648\u062A\u0628\u0642\u0649 \u0627\u0644\u0646\u0648\u0627\u0626\u0628 \u0627\u0644\u062B\u0644\u0627\u062B \u0643\u0645\u0627 \u0647\u064A \u2014 \u0645\u062D\u062F\u0650\u0651\u062F\u0627\u062A
 * \u0633\u0645\u0629\u064D \u0644\u0627 \u062A\u0637\u0627\u0628\u0642 \u0639\u0646\u0635\u0631\u0627\u064B \u0648\u0627\u062D\u062F\u0627\u064B.
 *
 * \u0648\u0627\u0644\u062A\u0639\u0644\u064A\u0642 \u0627\u0644\u0633\u0627\u0628\u0642 \u0643\u0627\u0646 \u064A\u0633\u0645\u0651\u064A \u0630\u0644\u0643 \xAB\u0641\u0634\u0644\u0627\u064B \u0644\u0637\u064A\u0641\u0627\u064B\xBB\u060C \u0648\u0647\u0648 \u0641\u064A \u0627\u0644\u062D\u0642\u064A\u0642\u0629 **\u0645\u0648\u062A\u064C \u0635\u0627\u0645\u062A**:
 * \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u062A\u064F\u0641\u0639\u064E\u0651\u0644 \u0648\u0644\u0627 \u064A\u0642\u0639 \u0627\u0644\u0636\u0628\u0627\u0628 \u0623\u0628\u062F\u0627\u064B \u0648\u0644\u0627 \u0633\u0637\u0631 \u064A\u0642\u0648\u0644 \u0644\u0645\u0627\u0630\u0627.
 *
 * \u0648\u0643\u0627\u0646 \u064A\u064F\u062D\u0630\u0651\u0631 \u0623\u064A\u0636\u0627\u064B \u0645\u0646 \u0623\u0646\u0651 \u0645\u062D\u062F\u0650\u0651\u062F \u0627\u0644\u0633\u0645\u0629 \xAB\u064A\u064F\u0641\u0631\u0637 \u0641\u064A \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629\xBB. \u0642\u0650\u064A\u0633: \u0643\u0644\u064C\u0651 \u0645\u0646
 * \`[class*="sidebar_"]\` \u0648\`[class*="members_"]\` \u064A\u0635\u064A\u0628 **\u0639\u0646\u0635\u0631\u0627\u064B \u0648\u0627\u062D\u062F\u0627\u064B \u0628\u0627\u0644\u0636\u0628\u0637**\u060C
 * \u0648\u0644\u0627 \u064A\u0644\u062A\u0642\u0637 \`sidebarList_\` \u0648\u0644\u0627 \`membersWrap_\` \u0644\u0623\u0646\u0651 \u0627\u0644\u0634\u0631\u0637\u0629 \u0627\u0644\u0633\u0641\u0644\u064A\u0629 \u0628\u0639\u062F \u0627\u0644\u0627\u0633\u0645
 * \u062A\u0641\u0635\u0644\u0647\u0645\u0627. \u0641\u0644\u0627 \u0625\u0641\u0631\u0627\u0637\u060C \u0648\u0644\u0627 \u0646\u062F\u0627\u0621\u064E \u0642\u062F \u064A\u0641\u0634\u0644.
 */
[class*="sidebar_"],
[class*="membersWrap_"],
[class*="members_"] {
    background-color: rgb(25 0 51 / 45%) !important;
    backdrop-filter: blur(10px) saturate(1.3);
}
`,classNames:{},dom:null});FDe="src/esharqplugins/glassPanels/style.css"});var Fq,FCt=h(()=>{"use strict";u();to();L();RCt();Fq=x({name:"GlassPanels",description:"Frosted-glass blur on the sidebar and member list.",authors:[{name:"Mc5mr",id:523157034141745153n}],tags:["Appearance","Customisation"],start:()=>Dn(FDe),stop:()=>kn(FDe)})});var JDe,JCt=h(()=>{u();(window.VencordStyles??=new Map).set("src/esharqplugins/gridFloor/style.css",{name:"src/esharqplugins/gridFloor/style.css",source:`body::before {
    content: "";
    position: fixed;
    left: -50%;
    right: -50%;
    bottom: 0;
    height: 38vh;
    z-index: 1;
    pointer-events: none;
    background-image:
        linear-gradient(rgb(1 205 254 / 50%) 2px, transparent 2px),
        linear-gradient(90deg, rgb(255 113 206 / 45%) 2px, transparent 2px);
    background-size: 48px 48px;
    transform: perspective(320px) rotateX(74deg);
    mask-image: linear-gradient(transparent, #000 80%);
    animation: mc-grid 4s linear infinite;
}

@keyframes mc-grid {
    from { background-position: 0 0; }
    to { background-position: 0 48px; }
}
