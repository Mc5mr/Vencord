img[class*="avatar"]:hover,
[class*="wrapper"] img[class*="avatar"]:hover {
    box-shadow: 0 0 12px 2px #ff71ce, 0 0 22px 4px #01cdfe;
    border-radius: 50%;
    transition: box-shadow 0.2s ease;
}

a:hover,
[class*="anchor"]:hover {
    text-shadow: 0 0 8px #01cdfe;
}

button[class*="lookFilled"]:hover {
