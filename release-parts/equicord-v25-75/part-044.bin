/* \`.mention\` is the pill itself and is not a mangled class. Matching [class*="mention"]
   also hit the pinged message row (mentioned__hash), the unread-mentions bar and
   vc-mentionAvatars-*, so whole rows were painted with the gradient. */
.mention {
    background: linear-gradient(90deg, rgb(255 113 206 / 35%), rgb(1 205 254 / 35%)) !important; /* overrides Discord's own .mention background */
    color: #fff0fb !important; /* the same Discord rule sets the pill text colour */
    border-radius: 6px;
    transition: filter 0.15s ease;
}

.mention:hover {
    filter: brightness(1.2);
}
