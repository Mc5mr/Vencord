{type:7,description:"The sound to play when new excluded Quests are detected.",default:DOe,hidden:!0},newExcludedQuestAlertVolume:{type:1,description:"The volume for the new excluded Quest alert sound.",default:vOe,hidden:!0},questTiles:{type:6,component:X.wrap(Krt),description:"Customize the appearance of Quest tiles in the Quests page."},questTileUnclaimedColor:{type:7,description:"The color of unclaimed Quest tiles in the Quests page.",default:{...C7},hidden:!0},questTileClaimedColor:{type:7,description:"The color of claimed Quest tiles in the Quests page.",default:{...I7},hidden:!0},questTileIgnoredColor:{type:7,description:"The color of ignored Quest tiles in the Quests page.",default:{...M7},hidden:!0},questTileExpiredColor:{type:7,description:"The color of expired Quest tiles in the Quests page.",default:{...E7},hidden:!0},questTileGradient:{type:0,description:"Style of the gradient used in the Quest tiles.",default:Vze,hidden:!0},questTilePreload:{type:3,description:"Attempt to preload the assets for the Quest tiles.",default:eOe,hidden:!0},reorderQuests:{type:6,description:"Sort Quests by their status.",component:X.wrap(nst)},questOrder:{type:7,description:"Sort order for Quest status groups.",default:Array.from(Gf),hidden:!0},hiddenQuestStatuses:{type:7,description:"Quest status groups to hide.",default:Array.from(tOe),hidden:!0},unclaimedSubsort:{type:0,description:"Subsort method for unclaimed Quests.",default:Q7,hidden:!0},claimedSubsort:{type:0,description:"Subsort method for claimed Quests.",default:Y7,hidden:!0},ignoredSubsort:{type:0,description:"Subsort method for ignored Quests.",default:N7,hidden:!0},expiredSubsort:{type:0,description:"Subsort method for expired Quests.",default:T7,hidden:!0},isOnQuestsPage:{type:3,description:"Whether the user is currently on the Quests page.",default:kOe,hidden:!0},rememberQuestPageSort:{type:3,description:"Remember the last used sort on the Quests page.",default:GOe,hidden:!0},rememberQuestPageFilters:{type:3,description:"Remember the last used filters on the Quests page.",default:SOe,hidden:!0},lastQuestPageSort:{type:0,description:"Remember the last used sort on the Quests page.",default:QOe,hidden:!0},lastQuestPageFilters:{type:7,description:"Remember the last used filters on the Quests page.",default:YOe,hidden:!0},ignoredQuestIDs:{type:7,description:"An array of Quest IDs that are ignored.",default:NOe,hidden:!0},resumeQuestIDs:{type:7,description:"An array of Quest IDs that are being or are queued to be auto-completed in the background.",default:TOe,hidden:!0}})});var ast,Ast=h(()=>{u();(window.VencordStyles??=new Map).set("src/equicordplugins/questify/styles.css",{name:"src/equicordplugins/questify/styles.css",source:`/* Miscellaneous */

/* Fix to overwrite bad CSS in callTimer/alignedChatInputFix.css */
[class*="panels"] [class*="questProgressWrapper"] [class*="outer"] > [class*="inner"] {
    height: 100% !important;
}

/* Fix to overwrite bad CSS in callTimer/alignedChatInputFix.css */
[class*="panels"] [class*="questProgressWrapper"] > div {
    opacity: 1 !important;
}

/* Fix oversized confetti blocking Quest buttons. */
[class*="rewardDescriptionContainer"] [class*="progressWrapper"] > [class*="confetti"] {
    pointer-events: none;
}

/* Fix Questify button text clipping. */
.questify-quest-item-restyle button [class*="buttonChildren"],
.questify-quest-item-restyle button span {
    overflow: visible;
}

/* Prevent shifting in the progress subtitle. */
[class*="questProgressHint_"] {
    font-variant-numeric: tabular-nums;
}

/* Notices */

.questify-startup-notice-body {
    line-height: normal;
}

/* Quest tile preview */

.questify-dummy-quest-preview {
    cursor: default;
    margin-top: 12px;
    user-select: none;
}

.questify-dummy-quest {
    margin-top: 8px;
}

/* Background of Quest tile. */
.questify-quest-item-restyle > :where(div) {
    background-color: var(--questify-color) !important;
}

/* Normal button text + SVG button text color. */
.questify-quest-item-restyle > :nth-child(2) button > *,
.questify-quest-item-restyle > :nth-child(2) button > * > * > span {
    color: var(--questify-quest-name);
}

/* Watch again button SVG color. */
.questify-quest-item-restyle > :nth-child(2) button > div > div > svg path {
    fill: var(--questify-quest-name);
}

/* Allows glowing reward previews which aren't confined to their own square video frame to overflow. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] {
    overflow: visible;
}

/* Quest name color. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] > [class*="questName_"] {
    color: var(--questify-quest-name) !important;
}

/* Reward title + Orbs reward title text color. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] [class*="header_"] {
    color: var(--questify-reward-title) !important;
}

/* Quest description text color. */
.questify-quest-item-restyle > div > div[class*="rewardDescriptionContainer"] > div[class*="textContainer"] > div[class*="text-sm"] {
    color: var(--questify-reward-description) !important;
}

.questify-quest-item-restyle [class*="placeholderElement"] {
    background-color: transparent;
}

/* Promoted by XYZ text color. */
.questify-quest-item-restyle > div[class*="container"] > div[class*="positionContentOverBackground"] > div[class*="contents"] > div[class*="bottomRow"] > div[class*="text-sm"] {
    color: var(--questify-reward-description) !important;
}

.questify-quest-item-contrast-logo > div[class*="container"] > div[class*="positionContentOverBackground"] > div[class*="contents"] > div[class*="partnerBranding"] > img {
    filter: drop-shadow(0 0 10px rgb(0 0 0 / 80%));
}

.questify-quest-item-intense-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            var(--questify-color) 0,
            hsl(from var(--questify-color) h s l / 100%) 20.5%,
            hsl(from var(--questify-color) h s l / 99.5%) 23.33%,
            hsl(from var(--questify-color) h s l / 98%) 26.66%,
            hsl(from var(--questify-color) h s l / 97%) 30%,
            hsl(from var(--questify-color) h s l / 90%) 40%,
            hsl(from var(--questify-color) h s l / 77%) 50%,
            hsl(from var(--questify-color) h s l / 0%) 100%);
}

.questify-quest-item-default-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            var(--questify-color) 0,
            hsl(from var(--questify-color) h s l / 95%) 20.31%,
            hsl(from var(--questify-color) h s l / 0%) 100%);
}

.questify-quest-item-black-gradient > :nth-child(1) [class*="overlay"] {
    background: linear-gradient(to top,
            hsl(0deg 0% 0% / 80%) 10%,
            hsl(0deg 0% 0% / 65%) 20%,
            hsl(0deg 0% 0% / 50%) 50%,
            hsl(0deg 0% 0% / 10%) 75%,
            hsl(0deg 0% 0% / 0%) 90%);
}

.questify-quest-item-hide-gradient > :nth-child(1) [class*="overlay"] {
    display: none;
}

.questify-quest-item-restyle > :nth-child(2) [class*="textOverflowBlur"] {
    background: linear-gradient(transparent 50%, var(--questify-color) 100%);
    filter: brightness(0.9);
}

.questify-quest-item-restyle > :nth-child(2) > div button {
    background-color: var(--questify-button-normal) !important;
}

.questify-quest-item-restyle > :nth-child(2) > div button:not([disabled]):hover {
    background-color: var(--questify-button-hover) !important;
    transition: background-color 0.2s ease-in-out;
}

.questify-quest-item-restyle > :nth-child(1) [class*="container"] {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.questify-quest-item-restyle > :nth-child(2) [class*="container"] {
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

div[id^="quest-tile-"] div[class^="confetti__"] {
    pointer-events: none;
}

/* Quest Button */

#questify-dummy-quest-button {
    margin-right: -12px;
    margin-left: 5px;
    border-left: 5px solid var(--text-strong);
    border-radius: 4px;
}

.questify-quest-button-pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    pointer-events: none;
}

.questify-quest-button-pill > [class*="item"] {
    will-change: transform;
    max-height: 8px;
    min-height: 8px;
    transition: max-height 0.2s ease-in-out;
}

.questify-quest-button-pill.hovered > [class*="item"] {
    max-height: 20px;
}

.questify-quest-button-pill.selected > [class*="item"] {
    max-height: 40px;
}

.questify-quest-button-server-list-button-container {
    position: relative;
}

.questify-quest-button-icon-container {
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

.questify-quest-button-container {
