#snowfield {
    pointer-events: none;
    user-select: none;
    z-index: 100000;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
}
.snowflake {
    position: absolute;
    color: #fff;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
}
.snowflake-solid {
    border-radius: 50%;
    background: #ffffff;
}
.snowflake-image {
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.5));
}
